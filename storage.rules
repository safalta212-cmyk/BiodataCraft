rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Template assets & uploads
    match /template-assets/{assetId} {
      allow read, write: if true;
    }
    match /uploads/{allPaths=**} {
      allow read, write: if true;
    }

    // STRICT ZERO CUSTOMER DATA GUARANTEE:
    // Block customer photo uploads to cloud storage
    match /customer-photos/{photoId} {
      allow read, write: if false;
    }
    match /user-uploads/{allPaths=**} {
      allow read, write: if false;
    }
    match /biodatas/{allPaths=**} {
      allow read, write: if false;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
