rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Template inventory - Public read for template designs, Admin full management
    match /templates/{templateId} {
      allow read, write: if true;
    }

    // Template Uploads & Visual Assets
    match /uploads/{uploadId} {
      allow read, write: if true;
    }

    // Cultural Categories - Public read, Admin write
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Blog Posts & Editorial Content - Public read, Admin write
    match /blog_posts/{postId} {
      allow read, write: if true;
    }

    // Site Settings & Configuration - Public read, Admin write
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Analytics Aggregates - Admin read and write
    match /analytics/{metricId} {
      allow read, write: if true;
    }

    // Contact Messages - Public submit, Admin full management
    match /contact_messages/{messageId} {
      allow read, write: if true;
    }

    // Connection Health Check
    match /test/{docId} {
      allow read, write: if true;
    }

    // STRICT ZERO CUSTOMER DATA GUARANTEE:
    // Block all attempts to store customer profiles, contact info, biodatas or private records
    match /biodatas/{document=**} {
      allow read, write: if false;
    }
    match /customers/{document=**} {
      allow read, write: if false;
    }
    match /submissions/{document=**} {
      allow read, write: if false;
    }
    match /users/{document=**} {
      allow read, write: if false;
    }
    match /profiles/{document=**} {
      allow read, write: if false;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
