# Application Configuration
VITE_APP_NAME="BiodataCraft"
VITE_APP_URL="https://biodatacraft.com"
VITE_APP_DESCRIPTION="Professional Indian Marriage Biodata Maker. 100% Free, Zero Customer Login, Client-Side Privacy."

# Firebase Client Configuration (Admin Authentication & Anonymous Telemetry Only)
# Never use Firebase Admin private keys in client code!
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="biodatacraft.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="biodatacraft"
VITE_FIREBASE_STORAGE_BUCKET="biodatacraft.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# Admin Access Credentials (For local development only)
VITE_ADMIN_PASSCODE="your-secure-admin-passcode"
VITE_ADMIN_EMAIL="admin@biodatacraft.internal"
VITE_ADMIN_PASSWORD=""

# AdSense Configuration (Now dynamically managed via Admin Panel at /admin/ads)
# Environment variables below are purely optional local development defaults:
VITE_ADSENSE_CLIENT_ID=""
VITE_ADS_ENABLED="false"
VITE_ADSENSE_SLOT_HEADER=""
VITE_ADSENSE_SLOT_FOOTER=""
VITE_ADSENSE_SLOT_DOWNLOAD=""

# AI Studio runtime injection (if used)
GEMINI_API_KEY=""
APP_URL=""
