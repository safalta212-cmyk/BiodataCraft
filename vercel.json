{
  "framework": "vite",
  "redirects": [
    { "source": "/builder", "destination": "/create", "permanent": true },
    { "source": "/privacy", "destination": "/privacy-policy", "permanent": true },
    { "source": "/topics", "destination": "/biodata", "permanent": true },
    { "source": "/biodata/marriage-biodata", "destination": "/marriage-biodata", "permanent": true },
    { "source": "/biodata/marriage-biodata-format", "destination": "/marriage-biodata-format", "permanent": true },
    { "source": "/biodata/hindu-marriage-biodata", "destination": "/hindu-marriage-biodata", "permanent": true },
    { "source": "/biodata/muslim-marriage-biodata", "destination": "/muslim-marriage-biodata", "permanent": true },
    { "source": "/biodata/yadav-marriage-biodata", "destination": "/yadav-marriage-biodata", "permanent": true },
    { "source": "/biodata/marathi-biodata", "destination": "/marathi-biodata", "permanent": true },
    { "source": "/biodata/bengali-marriage-biodata", "destination": "/bengali-marriage-biodata", "permanent": true },
    { "source": "/topic/:slug", "destination": "/biodata/:slug", "permanent": true },
    { "source": "/topics/:slug", "destination": "/biodata/:slug", "permanent": true },
    { "source": "/admin/settings/ads", "destination": "/admin/ads", "permanent": true },
    { "source": "/admin/settings/monetization", "destination": "/admin/ads", "permanent": true },
    { "source": "/admin/contact", "destination": "/admin/messages", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://apis.google.com https://*.firebaseapp.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://images.unsplash.com https://*.googleusercontent.com https://*.firebasestorage.app; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://*.firebaseapp.com https://identitytoolkit.googleapis.com https://firestore.googleapis.com; frame-src 'self' https://*.firebaseapp.com; object-src 'none'; base-uri 'self';" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
