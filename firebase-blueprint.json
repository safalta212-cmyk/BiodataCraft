{
  "entities": {
    "Template": {
      "title": "Template",
      "description": "Matrimonial biodata design template metadata",
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "description": "Unique URL identifier for the template"
        },
        "name": {
          "type": "string",
          "description": "Display name of the template"
        },
        "description": {
          "type": "string",
          "description": "Detailed explanation of cultural styling"
        },
        "categoryId": {
          "type": "string",
          "description": "Category identifier"
        },
        "categoryName": {
          "type": "string",
          "description": "Category title"
        },
        "religion": {
          "type": "string",
          "description": "Associated religious tradition or Universal"
        },
        "region": {
          "type": "string",
          "description": "Geographic/cultural region or Global"
        },
        "language": {
          "type": "string",
          "description": "Language support (English, Hindi, Bilingual, Any)"
        },
        "gender": {
          "type": "string",
          "description": "Target gender or Unisex"
        },
        "style": {
          "type": "string",
          "description": "Aesthetic style"
        },
        "thumbnail": {
          "type": "string",
          "description": "Storage URL or data URI for thumbnail card"
        },
        "previewImage": {
          "type": "string",
          "description": "Storage URL or data URI for high-res preview"
        },
        "isFree": {
          "type": "boolean",
          "description": "Whether template is accessible free of charge"
        },
        "isPremium": {
          "type": "boolean",
          "description": "Whether template is marked as premium"
        },
        "isPublished": {
          "type": "boolean",
          "description": "Whether template is live and visible to customers"
        },
        "sortOrder": {
          "type": "number",
          "description": "Integer ranking for display order"
        },
        "seoTitle": {
          "type": "string",
          "description": "Meta title for search optimization"
        },
        "seoDescription": {
          "type": "string",
          "description": "Meta description for search optimization"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when template was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when template was last updated"
        }
      },
      "required": ["slug", "name", "categoryId", "isPublished", "sortOrder"]
    },
    "Upload": {
      "title": "Upload",
      "description": "Template visual asset uploads and image metadata",
      "type": "object",
      "properties": {
        "fileName": {
          "type": "string",
          "description": "Name of the uploaded asset"
        },
        "url": {
          "type": "string",
          "description": "Storage download URL or base64 data URI"
        },
        "mimeType": {
          "type": "string",
          "description": "MIME type of the asset"
        },
        "size": {
          "type": "number",
          "description": "Size in bytes"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when file was uploaded"
        }
      },
      "required": ["fileName", "url", "createdAt"]
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "Editorial guides and advice articles for Indian matrimonial biodatas",
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "description": "URL slug for the blog article"
        },
        "title": {
          "type": "string",
          "description": "Article headline title"
        },
        "excerpt": {
          "type": "string",
          "description": "Summary excerpt shown in previews"
        },
        "category": {
          "type": "string",
          "description": "Article topic category"
        },
        "publishedDate": {
          "type": "string",
          "description": "Readable publication date string"
        },
        "readTime": {
          "type": "string",
          "description": "Estimated reading duration"
        },
        "author": {
          "type": "string",
          "description": "Author or editorial desk attribution"
        },
        "featuredImage": {
          "type": "string",
          "description": "URL or Data URI of hero image"
        },
        "seoTitle": {
          "type": "string",
          "description": "Search engine title tag"
        },
        "seoDescription": {
          "type": "string",
          "description": "Search engine meta description"
        },
        "isPublished": {
          "type": "boolean",
          "description": "Whether the article is published and publicly visible"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when article was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when article was updated"
        }
      },
      "required": ["slug", "title", "excerpt", "category", "isPublished"]
    },
    "TemplateCategory": {
      "title": "TemplateCategory",
      "description": "Matrimonial biodata template category taxonomy",
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "description": "URL slug for category"
        },
        "name": {
          "type": "string",
          "description": "Display name of category"
        },
        "description": {
          "type": "string",
          "description": "Description of the category"
        },
        "sortOrder": {
          "type": "number",
          "description": "Sort ordering index"
        }
      },
      "required": ["slug", "name", "sortOrder"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Customer support and general feedback inquiries",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Sender full name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Sender contact email"
        },
        "subject": {
          "type": "string",
          "description": "Topic or category of the inquiry"
        },
        "message": {
          "type": "string",
          "description": "Body content of the message"
        },
        "status": {
          "type": "string",
          "enum": ["unread", "read", "resolved"],
          "description": "Operational status of the inquiry"
        },
        "adminNotes": {
          "type": "string",
          "description": "Internal notes from support team"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when message was submitted"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when status was last modified"
        }
      },
      "required": ["name", "email", "subject", "message", "status", "createdAt"]
    }
  },
  "firestore": {
    "/templates/{templateId}": {
      "schema": "Template",
      "description": "Collection of matrimonial biodata design templates"
    },
    "/uploads/{uploadId}": {
      "schema": "Upload",
      "description": "Collection of template visual assets and uploaded designs"
    },
    "/blog_posts/{postId}": {
      "schema": "BlogPost",
      "description": "Collection of matrimonial guides and advice articles"
    },
    "/categories/{categoryId}": {
      "schema": "TemplateCategory",
      "description": "Collection of template cultural categories"
    },
    "/contact_messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Support messages and user feedback"
    }
  }
}
